# MariaDB-hærdning og kryptering i hvile (data-at-rest)
[mariadb]
# --- Kryptering i hvile -----------------------------------------------------
plugin_load_add                          = file_key_management
file_key_management_filename             = /etc/mysql/encryption/keys.enc
file_key_management_filekey              = FILE:/etc/mysql/encryption/filekey
file_key_management_encryption_algorithm = AES_CBC
innodb_encrypt_tables                    = FORCE
innodb_encrypt_log                       = ON
innodb_encrypt_temporary_tables          = ON
innodb_encryption_threads                = 2
encrypt_tmp_disk_tables                  = ON
encrypt_tmp_files                        = ON
encrypt_binlog                           = ON
aria_encrypt_tables                      = ON

# --- Hærdning ---------------------------------------------------------------
local_infile         = 0
skip_name_resolve    = ON
symbolic_links       = 0
secure_file_priv     = /var/lib/mysql-files
sql_mode             = STRICT_ALL_TABLES,NO_ZERO_DATE,NO_ZERO_IN_DATE,ERROR_FOR_DIVISION_BY_ZERO,NO_ENGINE_SUBSTITUTION,ONLY_FULL_GROUP_BY
character_set_server = utf8mb4
collation_server     = utf8mb4_unicode_ci
default_time_zone    = '+00:00'
max_connections      = 200
# Ingen generel query-log (kunne indeholde følsomme data)
general_log          = 0
