# Kopiér IKKE denne fil manuelt – kør `./scripts/init-secrets.sh`, som genererer
# .env med tilfældige, stærke værdier og MariaDB-krypteringsnøgler i ./secrets/.
# Alle værdier herunder er pladsholdere.

# --- Offentlig adresse -------------------------------------------------------
# Hostnavn som Caddy udsteder certifikat til. "localhost" bruger Caddys interne CA.
PUBLIC_HOST=localhost
HTTPS_PORT=8443
HTTP_PORT=8080
# HSTS max-age i sekunder. Start lavt i produktion (300) og øg gradvist til 31536000.
HSTS_MAX_AGE=300

# --- MariaDB -----------------------------------------------------------------
MARIADB_ROOT_PASSWORD=change-me
DB_MIGRATE_PASSWORD=change-me
DB_API_PASSWORD=change-me
DB_WORKER_PASSWORD=change-me

# --- Applikationshemmeligheder ----------------------------------------------
# Pepper til HMAC-opslag af adgangskoder (base64, 32 bytes). Rotation kræver ny kodeudstedelse.
CODE_LOOKUP_PEPPER=change-me
# Nøgle til HMAC-pseudonymisering af IP i rate-limit-tabellen (roteres dagligt afledt).
IP_HASH_KEY=change-me
# Nøgle til kryptering af TOTP-hemmeligheder i databasen (Fernet, urlsafe base64 32 bytes).
TOTP_ENC_KEY=change-me

# --- Politik -----------------------------------------------------------------
APP_ENV=production
APP_VERSION=1.0.0
# Minimum cellestørrelse for visning af aggregater (kan skærpes pr. tenant).
MIN_CELL_SIZE=10
# Respondent-session (sekunder, glidende) og absolut maks.
RESPONDENT_SESSION_TTL=3600
RESPONDENT_SESSION_MAX=43200
# Genoptagelsesnøgle gyldighed (dage).
RESUME_KEY_TTL_DAYS=14
# Admin-session (sekunder, glidende) og absolut maks.
ADMIN_SESSION_TTL=1800
ADMIN_SESSION_MAX=28800
# Rate limits: forsøg pr. vindue (sekunder)
RL_CODE_ATTEMPTS=5
RL_CODE_WINDOW=900
RL_LOGIN_ATTEMPTS=5
RL_LOGIN_WINDOW=900
# Standard dataopbevaring for rå besvarelser (måneder). Dataansvarlig fastsætter pr. tenant.
DEFAULT_RETENTION_MONTHS=24
